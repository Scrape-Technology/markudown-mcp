{
  "name": "markudown-mcp",
  "version": "2.1.0",
  "mcpName": "io.github.Scrape-Technology/markudown-mcp",
  "description": "MCP server for MarkUDown — connect AI agents to web scraping, search, and extraction",
  "type": "module",
  "bin": {
    "markudown-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/poll.test.ts",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/release.sh"
  },
  "files": ["dist/", "README.md"],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "web-scraping",
    "scraping-api",
    "crawler",
    "data-extraction",
    "markdown",
    "llm",
    "ai-agents"
  ],
  "homepage": "https://scrapetechnology.com/markudown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scrape-Technology/markudown-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Scrape-Technology/markudown-mcp/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": { "node": ">=20.0.0" }
}
